# Alpaca Markets — options chain with exchange Greeks (free tier: https://app.alpaca.markets)
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Tradier — options chain with ORATS Greeks, free sandbox (https://tradier.com → open a paper account)
# Get your token from Account Settings → API Access. Set TRADIER_SANDBOX=false once you have a live token.
TRADIER_TOKEN=your_token_here
TRADIER_SANDBOX=true

# Alpha Vantage — news + sentiment scoring (free: https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_KEY=your_key_here

# Finnhub — additional news feed (free: https://finnhub.io/register)
FINNHUB_KEY=your_key_here

# Marketaux — news + sentiment scoring, 100 req/day free, no CC (https://marketaux.com)
MARKETAUX_KEY=your_key_here

# Google Gemini — AI agent in sidebar + political-feed tagging (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_key_here

# Political feed (optional) — Truth Social has no official API. Defaults to the
# public trumpstruth.org RSS archive; override to use your own feed/proxy
# (e.g. TruthPing, TweetStream). Used by the "Political" tab.
# TRUTH_SOCIAL_RSS_URL=https://trumpstruth.org/feed

# Telegram alerts — fire when a Tariffs/Trade, Geopolitics, or Fed/Monetary post
# is tagged risk-on or risk-off. Polls every 90 seconds.
#
# Setup:
#   1. Message @BotFather on Telegram → /newbot → copy the token below
#   2. Message YOUR bot once, then visit:
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#      and copy the "id" field from the "chat" object → TELEGRAM_CHAT_ID
#
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
